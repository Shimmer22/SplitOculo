{
  "name": "splitoculo-gui",
  "version": "1.0.0",
  "description": "Desktop GUI for SplitOculo Edge-Cloud VLM Inference System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "keywords": [
    "electron",
    "vlm",
    "edge-computing",
    "deep-learning"
  ],
  "author": "SplitOculo Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "chart.js": "^4.4.1"
  },
  "build": {
    "appId": "com.splitoculo.gui",
    "productName": "SplitOculo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
